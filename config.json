{
  "llm": {
    "backend": "ollama",
    "base_url": "http://localhost:11434",
    "model": "llama3.2:1b",
    "timeout_seconds": 120,
    "temperature": 0.2
  },
  "analysis": {
    "max_functions_per_run": 50,
    "context_window_chars": 8000,
    "batch_size": 5
  },
  "output": {
    "report_dir": "reports/",
    "data_dir": "data/output/"
  },
  "logging": {
    "level": "INFO",
    "log_file": "data/output/run.log"
  }
}
